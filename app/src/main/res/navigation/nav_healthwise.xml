<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_healthwise"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.healthwise.fragments.OnboardingFragment"
        android:label="Onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_onboardingFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.healthwise.fragments.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.healthwise.fragments.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.healthwise.fragments.DashboardFragment"
        android:label="Home">
        <action
            android:id="@+id/action_dashboardFragment_to_symptomCheckerFragment"
            app:destination="@id/symptomCheckerFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_healthArticlesFragment"
            app:destination="@id/healthArticlesFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_symptomHistoryFragment"
            app:destination="@id/symptomHistoryFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_emergencyAlertFragment"
            app:destination="@id/emergencyAlertFragment" />
    </fragment>

    <fragment
        android:id="@+id/symptomCheckerFragment"
        android:name="com.example.healthwise.fragments.SymptomCheckerFragment"
        android:label="Symptoms">
        <action
            android:id="@+id/action_symptomCheckerFragment_to_analysisLoadingFragment"
            app:destination="@id/analysisLoadingFragment" />
        <action
            android:id="@+id/action_symptomCheckerFragment_to_emergencyAlertFragment"
            app:destination="@id/emergencyAlertFragment" />
    </fragment>

    <fragment
        android:id="@+id/analysisLoadingFragment"
        android:name="com.example.healthwise.fragments.AnalysisLoadingFragment"
        android:label="AI Analysis">
        <action
            android:id="@+id/action_analysisLoadingFragment_to_diagnosisResultFragment"
            app:destination="@id/diagnosisResultFragment"
            app:popUpTo="@id/symptomCheckerFragment" />
    </fragment>

    <fragment
        android:id="@+id/diagnosisResultFragment"
        android:name="com.example.healthwise.fragments.DiagnosisResultFragment"
        android:label="Results">
        <action
            android:id="@+id/action_diagnosisResultFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/healthArticlesFragment"
        android:name="com.example.healthwise.fragments.HealthArticlesFragment"
        android:label="Articles">
        <action
            android:id="@+id/action_healthArticlesFragment_to_articleDetailFragment"
            app:destination="@id/articleDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/articleDetailFragment"
        android:name="com.example.healthwise.fragments.ArticleDetailFragment"
        android:label="Article" />

    <fragment
        android:id="@+id/emergencyAlertFragment"
        android:name="com.example.healthwise.fragments.EmergencyAlertFragment"
        android:label="Emergency" />

    <fragment
        android:id="@+id/symptomHistoryFragment"
        android:name="com.example.healthwise.fragments.SymptomHistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.healthwise.fragments.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
