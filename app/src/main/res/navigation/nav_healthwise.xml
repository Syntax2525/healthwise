<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_healthwise"
    app:startDestination="@id/onboardingFragment">

    <fragment android:id="@+id/onboardingFragment" android:name="com.healthwiseai.ui.onboarding.OnboardingFragment" android:label="Onboarding">
        <action android:id="@+id/action_onboardingFragment_to_loginFragment" app:destination="@id/loginFragment" />
    </fragment>
    <fragment android:id="@+id/loginFragment" android:name="com.healthwiseai.ui.auth.LoginFragment" android:label="Login">
        <action android:id="@+id/action_loginFragment_to_registerFragment" app:destination="@id/registerFragment" />
        <action android:id="@+id/action_loginFragment_to_dashboardFragment" app:destination="@id/dashboardFragment" app:popUpTo="@id/onboardingFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/registerFragment" android:name="com.healthwiseai.ui.auth.RegisterFragment" android:label="Register">
        <action android:id="@+id/action_registerFragment_to_dashboardFragment" app:destination="@id/dashboardFragment" app:popUpTo="@id/onboardingFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/dashboardFragment" android:name="com.healthwiseai.ui.dashboard.DashboardFragment" android:label="Home">
        <action android:id="@+id/action_dashboardFragment_to_symptomCheckerFragment" app:destination="@id/symptomCheckerFragment" />
        <action android:id="@+id/action_dashboardFragment_to_healthArticlesFragment" app:destination="@id/healthArticlesFragment" />
        <action android:id="@+id/action_dashboardFragment_to_symptomHistoryFragment" app:destination="@id/symptomHistoryFragment" />
        <action android:id="@+id/action_dashboardFragment_to_profileFragment" app:destination="@id/profileFragment" />
        <action android:id="@+id/action_dashboardFragment_to_emergencyAlertFragment" app:destination="@id/emergencyAlertFragment" />
    </fragment>
    <fragment android:id="@+id/symptomCheckerFragment" android:name="com.healthwiseai.ui.symptomchecker.SymptomCheckerFragment" android:label="Symptoms">
        <action android:id="@+id/action_symptomCheckerFragment_to_analysisLoadingFragment" app:destination="@id/analysisLoadingFragment" />
    </fragment>
    <fragment android:id="@+id/analysisLoadingFragment" android:name="com.healthwiseai.ui.analysis.AnalysisLoadingFragment" android:label="AI Analysis">
        <action android:id="@+id/action_analysisLoadingFragment_to_diagnosisResultFragment" app:destination="@id/diagnosisResultFragment" app:popUpTo="@id/symptomCheckerFragment" />
    </fragment>
    <fragment android:id="@+id/diagnosisResultFragment" android:name="com.healthwiseai.ui.results.DiagnosisResultFragment" android:label="Results" />
    <fragment android:id="@+id/healthArticlesFragment" android:name="com.healthwiseai.ui.articles.HealthArticlesFragment" android:label="Articles">
        <action android:id="@+id/action_healthArticlesFragment_to_articleDetailFragment" app:destination="@id/articleDetailFragment" />
    </fragment>
    <fragment android:id="@+id/articleDetailFragment" android:name="com.healthwiseai.ui.articles.ArticleDetailFragment" android:label="Article" />
    <fragment android:id="@+id/emergencyAlertFragment" android:name="com.healthwiseai.ui.emergency.EmergencyAlertFragment" android:label="Emergency" />
    <fragment android:id="@+id/symptomHistoryFragment" android:name="com.healthwiseai.ui.history.SymptomHistoryFragment" android:label="History" />
    <fragment android:id="@+id/profileFragment" android:name="com.healthwiseai.ui.profile.ProfileFragment" android:label="Profile" />
</navigation>
